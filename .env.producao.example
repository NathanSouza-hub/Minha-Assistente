# Modelo do .env de PRODUÇÃO (no servidor, na pasta do projeto: cp .env.producao.example .env).
# Passo a passo em docs/deploy.md. Nunca suba o .env para o Git.

# Endereço do app. Sem domínio ainda? Use o IP do servidor com traços + .sslip.io
# (ex.: IP 203.0.113.10 → 203-0-113-10.sslip.io): já funciona com HTTPS.
DOMINIO=203-0-113-10.sslip.io
# E-mail para o Let's Encrypt avisar sobre o certificado.
EMAIL_CERTIFICADO=voce@exemplo.com

# Gere com: openssl rand -hex 24   (só letras e números: vai dentro da URL do banco)
POSTGRES_PASSWORD=
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Notificações (lembretes). Gere com:
#   docker run --rm node:22-alpine npx -y web-push generate-vapid-keys
# Não troque depois: trocar as chaves desliga as notificações de todos os aparelhos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Cadastro de contas pelo app. Fechado: contas novas com src/cli/criar-conta.js (docs/deploy.md).
CADASTRO_ABERTO=false

# WhatsApp (Cloud API da Meta). Sem estas cinco, o WhatsApp fica desligado. Passo a passo em
# docs/deploy.md. Webhook: https://<DOMINIO>/api/webhooks/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_NUMERO_ID=
# Número do app, só dígitos com o país (ex.: 5511999990000)
WHATSAPP_NUMERO=
WHATSAPP_APP_SECRET=
# Invente um texto longo; é o mesmo que vai no campo "Verify token" da Meta (openssl rand -hex 24)
WHATSAPP_VERIFY_TOKEN=
