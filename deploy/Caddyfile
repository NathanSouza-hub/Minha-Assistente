# Caddy: HTTPS automático (Let's Encrypt) para {$SITE}, o front (PWA) e a API em /api.
# Atrás de um proxy compartilhado (docker-compose.proxy.yml), SITE vira ":80" (só HTTP; o HTTPS
# fica no proxy) e PROXIES_CONFIAVEIS aceita o IP do cliente que o proxy manda em X-Forwarded-For.
{
	email {$EMAIL_CERTIFICADO}
	servers {
		trusted_proxies static {$PROXIES_CONFIAVEIS:127.0.0.1/32}
	}
}

{$SITE} {
	encode zstd gzip

	# API: o prefixo /api sai antes de repassar (a API responde em /, /eventos, /docs...).
	handle_path /api/* {
		# Só o IP do cliente: a API confia em um proxy (trust proxy 1) e lê o último da lista.
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Front: arquivos do build; rotas do app (/agenda, /remedios...) caem no index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Arquivos com hash no nome nunca mudam; o resto (index.html, sw.js, manifest) é sempre
	# revalidado, senão a atualização do app demora a chegar nos aparelhos.
	@comHash path /assets/*
	header @comHash Cache-Control "public, max-age=31536000, immutable"
	@resto {
		not path /assets/* /api/*
	}
	header @resto Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
