# Ambiente: development | test | production
NODE_ENV=development
PORT=3000

# Conexão PostgreSQL (docker compose up -d sobe este banco)
DATABASE_URL=postgres://minha_assistente:minha_assistente_dev@localhost:5433/minha_assistente
# Banco separado usado por `npm test` (é apagado e recriado pelos testes)
DATABASE_URL_TEST=postgres://minha_assistente:minha_assistente_dev@localhost:5433/minha_assistente_test

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-longo-de-pelo-menos-32-caracteres
JWT_EXPIRES_IN=30d

# Origens liberadas no CORS (separadas por vírgula). Ex.: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Diretório dos anexos de viagem
UPLOADS_DIR=uploads

# Web Push dos lembretes. Gere o par com: npx web-push generate-vapid-keys
# Sem as chaves, a API funciona normalmente, mas não envia lembretes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
