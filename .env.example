# Ambiente: development | test | production
NODE_ENV=development
PORT=3000

# Conexão PostgreSQL (docker compose up -d sobe este banco)
DATABASE_URL=postgres://minha_assistente:minha_assistente_dev@localhost:5433/minha_assistente
# Banco separado usado por `npm test` (é apagado e recriado pelos testes)
DATABASE_URL_TEST=postgres://minha_assistente:minha_assistente_dev@localhost:5433/minha_assistente_test

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-longo-de-pelo-menos-32-caracteres
JWT_EXPIRES_IN=30d

# Origens liberadas no CORS (separadas por vírgula). Ex.: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Diretório dos anexos de viagem
UPLOADS_DIR=uploads

# Web Push dos lembretes. Gere o par com: npx web-push generate-vapid-keys
# Sem as chaves, a API funciona normalmente, mas não envia lembretes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Cadastro de contas pelo app (sem a variável: aberto fora de produção).
CADASTRO_ABERTO=true

# WhatsApp (Cloud API da Meta): ligar o número por código e lembretes. Sem estas cinco, fica
# desligado. Passo a passo em docs/deploy.md, "WhatsApp". Webhook: https://<DOMINIO>/api/webhooks/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_NUMERO_ID=
# Número do app, só dígitos com o país (ex.: 5511999990000)
WHATSAPP_NUMERO=
WHATSAPP_APP_SECRET=
# Invente um texto longo; é o mesmo que vai no campo "Verify token" da Meta (openssl rand -hex 24)
WHATSAPP_VERIFY_TOKEN=
# Modelo aprovado na Meta para os lembretes, com {{1}} = título e {{2}} = detalhe.
WHATSAPP_MODELO=lembrete
WHATSAPP_MODELO_IDIOMA=pt_BR

# Claude (Anthropic): o assistente do WhatsApp lança contas, compromissos e tarefas por mensagem.
# Vazia = desligado (o número ligado só recebe os lembretes). docs/deploy.md, "Assistente".
ANTHROPIC_API_KEY=
# Lançamento pelo WhatsApp acima deste valor, em centavos (100000 = R$ 1.000,00), pede "SIM" antes.
WHATSAPP_CONFIRMAR_ACIMA_CENTAVOS=100000
